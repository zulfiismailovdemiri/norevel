# Settings shared by app, queue and scheduler (no secrets; ports come from noredock.compose.toml).
# Real environment variables win over app/.env in Laravel, so these override the SQLite defaults.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_DATABASE=norevel
DB_USERNAME=postgres
DB_PASSWORD=
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_FROM_ADDRESS=hello@norevel.local
